# --- Servidor ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Nota: por ahora el backend usa datos en memoria (sin base de datos todavía).
# Cuando conectemos PostgreSQL y JWT real, aquí se irán agregando DB_* y JWT_SECRET.

# --- Vertex AI / Gemini ---
# Si estas variables NO están configuradas, el backend usa el generador
# simulado (para poder seguir desarrollando sin gastar cuota de la IA).
#
# 1. Crea/selecciona un proyecto en https://console.cloud.google.com
# 2. Habilita la API: https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
# 3. Crea una cuenta de servicio con rol "Vertex AI User" y descarga su llave JSON
#    (IAM y administración → Cuentas de servicio → Crear → Claves → Agregar clave → JSON)
# 4. Guarda ese archivo en backend/credentials/vertex-service-account.json
#    (esa carpeta ya está en .gitignore, NUNCA la subas a git)
GOOGLE_CLOUD_PROJECT=smartflow-506917
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=./credentials/vertex-service-account.json
